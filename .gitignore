# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which may contain sensitive data
*.tfvars
*.tfvars.json

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Exclude Terraform plan output files, which can contain sensitive data, such as provider
*.tfplan
# exclude data sources
source/

# Exclude Terraform plan output files, which can contain sensitive data, such as provider
*.plan